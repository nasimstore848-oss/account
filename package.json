{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed.ts",
    "db:constraints": "tsx src/db/apply-constraints.ts",
    "db:setup": "drizzle-kit push && tsx src/db/apply-constraints.ts && tsx src/db/seed.ts",
    "test:rules": "tsx scripts/verify-accounting-rules.ts",
    "test:lifecycle": "tsx scripts/test-voucher-lifecycle.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "test:voice": "tsx scripts/test-voice-system.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.49.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "tsx": "^4.19.3",
    "typescript": "5.9.3"
  }
}
